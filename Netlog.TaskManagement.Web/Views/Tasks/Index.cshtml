@model List<Netlog.TaskManagement.Web.Models.TaskItem>

@{
    ViewData["Title"] = "Görevler";
}

<h2>Görev Listesi</h2>

<p>Developer Sayısı: @ViewBag.DeveloperCount</p>

<a asp-action="Create" class="btn btn-primary mb-3">
    Yeni Görev Ekle
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Görev Adı</th>
            <th>Zorluk</th>
            <th>Durum</th>
            <th>Developer</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var taskItem in Model)
        {
            <tr>
                <td>@taskItem.Id</td>
                <td>@taskItem.Title</td>
                <td>@taskItem.Difficulty</td>
                <td>@taskItem.Status</td>
                <td>
                    @if (taskItem.DeveloperId == null)
                    {
                        <span>Atanamadı</span>
                    }
                    else
                    {
                        <span>Developer @taskItem.DeveloperId</span>
                    }
                </td>
                <td> 
                    <a asp-action="Edit" asp-route-id="@taskItem.Id"
                       class="btn btn-warning btn-sm">
                        Düzenle
                    </a>

                    @if (taskItem.Status != TaskItemStatus.Completed)
                    {
                        <form asp-action="Delete" asp-route-id="@taskItem.Id" method="post">
                            <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                        </form>
                    }

                    
                    
                    <form asp-action="UpdateStatus" asp-route-id="@taskItem.Id" method="post">
                        <select name="newStatus" class="form-select">
                            @foreach (TaskItemStatus status in Enum.GetValues<TaskItemStatus>())
                            {
                                if (taskItem.Status == status)
                                {
                                    <option value="@status" selected>@status</option>
                                }
                                else
                                {
                                    <option value="@status">@status</option>
                                }
                            }
                        </select>

                        <button type="submit" class="btn btn-primary btn-sm">
                            Güncelle
                        </button>
                    </form>

                    
                    @if (taskItem.Status == TaskItemStatus.Pending)
                    {
                        <form asp-action="RetryAssignment" asp-route-id="@taskItem.Id" method="post">
                            <button type="submit" class="btn btn-success btn-sm">
                                Atamayı Tekrar Dene
                            </button>
                        </form>
                    }


                </td>
            </tr>
        }
    </tbody>
</table>
